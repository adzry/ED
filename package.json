{
  "name": "ed-pharmacy-visibility-video",
  "version": "1.0.0",
  "description": "Explainer video: ED-to-ward patient location visibility for Inpatient Pharmacy (proposed PHIS workflow)",
  "scripts": {
    "setup": "pip install -r requirements.txt && tools/fetch_voice.sh",
    "narrate": "python3 tools/narrate.py",
    "check:layout": "node tools/check_layout.mjs",
    "check:text": "python3 tools/check_text.py",
    "validate": "npm run check:layout && npm run check:text",
    "render": "node tools/render.mjs",
    "mix": "tools/mix.sh",
    "check:output": "python3 tools/check_output.py",
    "stills": "node tools/render.mjs --stills 2.5,8,16,28,42,52,58,68,78,91",
    "build": "npm run narrate && npm run validate && npm run render && npm run mix && npm run check:output && npm run stills"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adzry/ED.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/adzry/ED/issues"
  },
  "homepage": "https://github.com/adzry/ED#readme",
  "devDependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "playwright-core": "1.56"
  },
  "private": true,
  "type": "module"
}
